# Copy to .env and fill in. Both keys are optional; set the one(s) for
# the backend(s) you want to use.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://cloud.digitalocean.com/account/api/genai-tokens
DIGITAL_OCEAN_MODEL_ACCESS_KEY=

# Optional defaults
BRIEFING_BACKEND=anthropic           # anthropic | do
BRIEFING_ANTHROPIC_MODEL=claude-opus-4-7
BRIEFING_DO_MODEL=llama3.3-70b-instruct
